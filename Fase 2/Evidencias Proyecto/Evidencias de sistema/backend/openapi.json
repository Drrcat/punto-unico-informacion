  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "EquipamientoDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "cantidad": {
            "type": "number",
            "minimum": 1,
            "maximum": 32767
          },
          "observacion": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          }
        },
        "required": [
          "nombre"
        ]
      },
      "CrearSalaDto": {
        "type": "object",
        "properties": {
          "pisoId": {
            "type": "number",
            "minimum": 1
          },
          "tipoEspacioId": {
            "type": "number",
            "minimum": 1
          },
          "codigo": {
            "type": "string",
            "description": "Código visible, único dentro del piso (p. ej. \"S01\" o \"PA-323\").",
            "minLength": 1,
            "maxLength": 30
          },
          "nombre": {
            "type": "string",
            "nullable": true,
            "maxLength": 120
          },
          "svgElementId": {
            "type": "string",
            "nullable": true,
            "description": "Id del elemento del plano SVG que se resalta al mostrar la sala.",
            "maxLength": 80
          },
          "capacidad": {
            "type": "number",
            "nullable": true,
            "minimum": 0,
            "maximum": 32767
          },
          "activo": {
            "type": "boolean"
          },
          "alias": {
            "description": "Nombres alternativos con los que también se debe encontrar la sala.",
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120,
              "minLength": 1
            }
          },
          "equipamiento": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EquipamientoDto"
            }
          }
        },
        "required": [
          "pisoId",
          "tipoEspacioId",
          "codigo"
        ]
      },
      "ActualizarSalaDto": {
        "type": "object",
        "properties": {
          "pisoId": {
            "type": "number",
            "minimum": 1
          },
          "tipoEspacioId": {
            "type": "number",
            "minimum": 1
          },
          "codigo": {
            "type": "string",
            "description": "Código visible, único dentro del piso (p. ej. \"S01\" o \"PA-323\").",
            "minLength": 1,
            "maxLength": 30
          },
          "nombre": {
            "type": "string",
            "nullable": true,
            "maxLength": 120
          },
          "svgElementId": {
            "type": "string",
            "nullable": true,
            "description": "Id del elemento del plano SVG que se resalta al mostrar la sala.",
            "maxLength": 80
          },
          "capacidad": {
            "type": "number",
            "nullable": true,
            "minimum": 0,
            "maximum": 32767
          },
          "activo": {
            "type": "boolean"
          },
          "alias": {
            "description": "Nombres alternativos con los que también se debe encontrar la sala.",
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120,
              "minLength": 1
            }
          },
          "equipamiento": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EquipamientoDto"
            }
          }
        }
      },
      "CrearAreaDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "descripcion": {
            "type": "string",
            "nullable": true,
            "maxLength": 300
          },
          "espacioId": {
            "type": "number",
            "nullable": true,
            "description": "Sala u oficina donde atiende el área.",
            "minimum": 1
          },
          "horarioAtencion": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "correoContacto": {
            "type": "string",
            "nullable": true,
            "description": "Casilla compartida del área, no un correo personal.",
            "maxLength": 150,
            "format": "email"
          },
          "anexo": {
            "type": "string",
            "nullable": true,
            "maxLength": 20
          }
        },
        "required": [
          "nombre"
        ]
      },
      "ActualizarAreaDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "descripcion": {
            "type": "string",
            "nullable": true,
            "maxLength": 300
          },
          "espacioId": {
            "type": "number",
            "nullable": true,
            "description": "Sala u oficina donde atiende el área.",
            "minimum": 1
          },
          "horarioAtencion": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "correoContacto": {
            "type": "string",
            "nullable": true,
            "description": "Casilla compartida del área, no un correo personal.",
            "maxLength": 150,
            "format": "email"
          },
          "anexo": {
            "type": "string",
            "nullable": true,
            "maxLength": 20
          }
        }
      },
