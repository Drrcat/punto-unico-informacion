        "type": "object",
        "properties": {
          "correo": {
            "type": "string",
            "description": "Correo institucional de la persona.",
            "maxLength": 150,
            "format": "email"
          }
        },
        "required": [
          "correo"
        ]
      },
      "ValidarCodigoDto": {
        "type": "object",
        "properties": {
