    "/api/enrolamiento/estado": {
      "get": {
        "operationId": "EnrolamientoController_estado",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "summary": "Indica si el módulo está activo y qué parámetros usa (dominios aceptados, intentos).",
        "tags": [
          "Enrolamiento"
        ]
      }
    },
    "/api/enrolamiento/autenticar": {
      "post": {
        "operationId": "EnrolamientoController_autenticar",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IniciarVerificacionDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Inicia la verificación: envía un código de un solo uso al correo institucional.",
        "tags": [
          "Enrolamiento"
        ]
      }
    },
    "/api/enrolamiento/autenticar/{id}/codigo": {
      "post": {
        "operationId": "EnrolamientoController_validarCodigo",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidarCodigoDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Valida el código ingresado. Si es correcto, crea la solicitud y entrega el token para enviar la foto.",
        "tags": [
          "Enrolamiento"
        ]
      }
    },
    "/api/enrolamiento/{id}/foto": {
      "post": {
        "operationId": "EnrolamientoController_foto",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "foto": {
                    "type": "string",
                    "format": "binary",
                    "description": "JPG o PNG. Se puede omitir para reintentar con la copia conservada tras una falla técnica."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Valida la fotografía con Google Vision AI y la envía al sistema de enrolamiento.",
        "tags": [
          "Enrolamiento"
        ]
      }
    },
    "/api/enrolamiento/{id}/cancelar": {
      "post": {
        "operationId": "EnrolamientoController_cancelar",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cancela la solicitud y elimina cualquier fotografía pendiente (por ejemplo, por inactividad).",
        "tags": [
          "Enrolamiento"
        ]
      }
    },
    "/api/enrolamiento/solicitudes": {
      "get": {
        "operationId": "EnrolamientoController_solicitudes",
        "parameters": [
          {
            "name": "estado",
            "required": false,
            "in": "query",
            "description": "Estado de la solicitud. Los `VERIFICACION_*` son solicitudes que no pasaron la verificación del correo.",
            "schema": {
              "type": "string",
              "enum": [
                "INICIADO",
                "FOTO_PENDIENTE",
                "COMPLETADO",
                "FALLIDO",
                "CANCELADO",
                "VERIFICACION_PENDIENTE",
                "VERIFICACION_EXPIRADA",
                "VERIFICACION_RECHAZADA"
              ]
            }
          },
          {
            "name": "correo",
            "required": false,
            "in": "query",
            "description": "Texto contenido en el correo.",
            "schema": {
              "minLength": 1,
              "maxLength": 150,
              "type": "string"
            }
          },
          {
            "name": "desde",
            "required": false,
            "in": "query",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "name": "hasta",
            "required": false,
            "in": "query",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "name": "limite",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "type": "number"
            }
          },
          {
            "name": "desplazamiento",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Consulta el estado de las solicitudes de enrolamiento (administrador).",
        "tags": [
          "Enrolamiento"
        ]
      }
    }
  },
